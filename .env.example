# Copy to .env (gitignored) and fill in. Real env vars override these in prod.

# balldontlie API key for the data-freshness pipeline (app.balldontlie.io).
# Free tier = final scores only (no box scores); GOAT tier adds box scores.
BALLDONTLIE_API_KEY=

# Optional: require X-API-Key on mutating endpoints (upload/train/predict/sync).
# Leave unset for local dev (no auth enforced).
# NBA_API_KEY=

# Optional overrides
# NBA_DB_PATH=./data/nba_predictions.db
# NBA_CORS_ORIGINS=http://localhost:8080
